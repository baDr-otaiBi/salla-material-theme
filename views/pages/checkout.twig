{% extends 'layout/base.twig' %}

{% block title %}إتمام الطلب - {{ store.name }}{% endblock %}
{% block body_class %}page-checkout{% endblock %}

{% block content %}
  <div class="container" style="padding-top:var(--md-sys-spacing-lg);">

    {# Breadcrumb #}
    <nav class="md-breadcrumb" aria-label="مسار التنقل">
      <div class="md-breadcrumb__item">
        <a href="{{ store.url }}" class="md-breadcrumb__link">الرئيسية</a>
        <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
      </div>
      <div class="md-breadcrumb__item">
        <a href="{{ store.url }}/cart" class="md-breadcrumb__link">سلة التسوق</a>
        <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
      </div>
      <div class="md-breadcrumb__item">
        <span class="md-breadcrumb__current" aria-current="page">إتمام الطلب</span>
      </div>
    </nav>

    <h1 class="md-headline-large" style="color:var(--md-sys-color-on-surface);margin-bottom:var(--md-sys-spacing-xl);">
      إتمام الطلب
    </h1>

    {# Checkout Steps Indicator #}
    <div class="checkout-steps" style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:var(--md-sys-spacing-2xl);flex-wrap:wrap;">
      <div class="checkout-step checkout-step--active" style="display:flex;align-items:center;gap:8px;">
        <span style="width:32px;height:32px;border-radius:var(--md-sys-shape-corner-full);background:var(--md-sys-color-primary);color:var(--md-sys-color-on-primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;">1</span>
        <span style="font-weight:600;font-size:var(--md-sys-typescale-label-large-size);color:var(--md-sys-color-primary);">بيانات الشحن</span>
      </div>
      <span class="material-symbols-rounded" style="font-size:18px;color:var(--md-sys-color-outline)" aria-hidden="true">chevron_left</span>
      <div class="checkout-step" style="display:flex;align-items:center;gap:8px;">
        <span style="width:32px;height:32px;border-radius:var(--md-sys-shape-corner-full);background:var(--md-sys-color-surface-container-high);color:var(--md-sys-color-on-surface-variant);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;">2</span>
        <span style="font-size:var(--md-sys-typescale-label-large-size);color:var(--md-sys-color-on-surface-variant);">الدفع</span>
      </div>
      <span class="material-symbols-rounded" style="font-size:18px;color:var(--md-sys-color-outline)" aria-hidden="true">chevron_left</span>
      <div class="checkout-step" style="display:flex;align-items:center;gap:8px;">
        <span style="width:32px;height:32px;border-radius:var(--md-sys-shape-corner-full);background:var(--md-sys-color-surface-container-high);color:var(--md-sys-color-on-surface-variant);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;">3</span>
        <span style="font-size:var(--md-sys-typescale-label-large-size);color:var(--md-sys-color-on-surface-variant);">التأكيد</span>
      </div>
    </div>

    {% if error %}
      <div style="background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container);padding:12px 16px;border-radius:var(--md-sys-shape-corner-medium);margin-bottom:var(--md-sys-spacing-lg);font-size:var(--md-sys-typescale-body-medium-size);">
        <span class="material-symbols-rounded" style="font-size:18px;vertical-align:middle;margin-inline-end:6px" aria-hidden="true">error</span>
        {{ error }}
      </div>
    {% endif %}

    <form method="POST" action="{{ store.url }}/checkout" novalidate>
      {{ csrf_field() }}

      <div class="checkout-layout">

        {# Checkout Form #}
        <div class="checkout-form">

          {# Shipping Information #}
          <section class="checkout-section" style="background:var(--md-sys-color-surface-container-lowest);border-radius:var(--md-sys-shape-corner-extra-large);padding:var(--md-sys-spacing-xl);border:1px solid var(--md-sys-color-outline-variant);margin-bottom:var(--md-sys-spacing-lg);">
            <h2 style="font-size:var(--md-sys-typescale-title-large-size);font-weight:700;color:var(--md-sys-color-on-surface);margin-bottom:var(--md-sys-spacing-lg);display:flex;align-items:center;gap:8px;">
              <span class="material-symbols-rounded" style="color:var(--md-sys-color-primary)" aria-hidden="true">local_shipping</span>
              بيانات الشحن
            </h2>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--md-sys-spacing-md);">
              <div class="md-field">
                <label class="md-field__label" for="first_name">الاسم الأول</label>
                <input class="md-field__input" type="text" id="first_name" name="first_name" required autocomplete="given-name" value="{{ customer.first_name ?? old.first_name }}">
              </div>
              <div class="md-field">
                <label class="md-field__label" for="last_name">اسم العائلة</label>
                <input class="md-field__input" type="text" id="last_name" name="last_name" required autocomplete="family-name" value="{{ customer.last_name ?? old.last_name }}">
              </div>
            </div>

            <div class="md-field" style="margin-top:var(--md-sys-spacing-md);">
              <label class="md-field__label" for="phone">رقم الجوال</label>
              <input class="md-field__input" type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="05xxxxxxxx" value="{{ customer.phone ?? old.phone }}">
            </div>

            <div class="md-field" style="margin-top:var(--md-sys-spacing-md);">
              <label class="md-field__label" for="email">البريد الإلكتروني</label>
              <input class="md-field__input" type="email" id="email" name="email" required autocomplete="email" value="{{ customer.email ?? old.email }}">
            </div>

            <div class="md-field" style="margin-top:var(--md-sys-spacing-md);">
              <label class="md-field__label" for="city">المدينة</label>
              <select class="md-field__input" id="city" name="city" required>
                <option value="">اختر المدينة</option>
                {% for city in cities %}
                  <option value="{{ city.id }}" {% if old.city == city.id %}selected{% endif %}>{{ city.name }}</option>
                {% endfor %}
              </select>
            </div>

            <div class="md-field" style="margin-top:var(--md-sys-spacing-md);">
              <label class="md-field__label" for="address">العنوان التفصيلي</label>
              <textarea class="md-field__textarea" id="address" name="address" rows="3" required autocomplete="street-address" placeholder="الحي، الشارع، رقم المبنى...">{{ old.address }}</textarea>
            </div>

            <div class="md-field" style="margin-top:var(--md-sys-spacing-md);">
              <label class="md-field__label" for="notes">ملاحظات إضافية (اختياري)</label>
              <textarea class="md-field__textarea" id="notes" name="notes" rows="2" placeholder="أي تعليمات خاصة بالتوصيل...">{{ old.notes }}</textarea>
            </div>
          </section>

          {# Payment Method #}
          <section class="checkout-section" style="background:var(--md-sys-color-surface-container-lowest);border-radius:var(--md-sys-shape-corner-extra-large);padding:var(--md-sys-spacing-xl);border:1px solid var(--md-sys-color-outline-variant);">
            <h2 style="font-size:var(--md-sys-typescale-title-large-size);font-weight:700;color:var(--md-sys-color-on-surface);margin-bottom:var(--md-sys-spacing-lg);display:flex;align-items:center;gap:8px;">
              <span class="material-symbols-rounded" style="color:var(--md-sys-color-primary)" aria-hidden="true">credit_card</span>
              طريقة الدفع
            </h2>

            <div style="display:flex;flex-direction:column;gap:var(--md-sys-spacing-sm);">
              {% for method in payment_methods %}
                <label class="checkout-payment-method" style="display:flex;align-items:center;gap:var(--md-sys-spacing-md);padding:var(--md-sys-spacing-md);border:1.5px solid var(--md-sys-color-outline-variant);border-radius:var(--md-sys-shape-corner-large);cursor:pointer;transition:border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);">
                  <input type="radio" name="payment_method" value="{{ method.id }}" required style="accent-color:var(--md-sys-color-primary);width:20px;height:20px;flex-shrink:0;" {% if loop.first %}checked{% endif %}>
                  <div style="flex:1;">
                    <div style="font-weight:600;font-size:var(--md-sys-typescale-title-small-size);color:var(--md-sys-color-on-surface);">{{ method.name }}</div>
                    {% if method.description %}
                      <div style="font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);">{{ method.description }}</div>
                    {% endif %}
                  </div>
                  {% if method.icon %}
                    <img src="{{ method.icon }}" alt="{{ method.name }}" height="28" loading="lazy">
                  {% endif %}
                </label>
              {% else %}
                <label class="checkout-payment-method" style="display:flex;align-items:center;gap:var(--md-sys-spacing-md);padding:var(--md-sys-spacing-md);border:1.5px solid var(--md-sys-color-outline-variant);border-radius:var(--md-sys-shape-corner-large);cursor:pointer;">
                  <input type="radio" name="payment_method" value="card" checked style="accent-color:var(--md-sys-color-primary);width:20px;height:20px;flex-shrink:0;">
                  <span class="material-symbols-rounded" style="color:var(--md-sys-color-primary)" aria-hidden="true">credit_card</span>
                  <span style="font-weight:600;color:var(--md-sys-color-on-surface);">بطاقة ائتمان / مدى</span>
                </label>
                <label class="checkout-payment-method" style="display:flex;align-items:center;gap:var(--md-sys-spacing-md);padding:var(--md-sys-spacing-md);border:1.5px solid var(--md-sys-color-outline-variant);border-radius:var(--md-sys-shape-corner-large);cursor:pointer;">
                  <input type="radio" name="payment_method" value="bank_transfer" style="accent-color:var(--md-sys-color-primary);width:20px;height:20px;flex-shrink:0;">
                  <span class="material-symbols-rounded" style="color:var(--md-sys-color-primary)" aria-hidden="true">account_balance</span>
                  <span style="font-weight:600;color:var(--md-sys-color-on-surface);">تحويل بنكي</span>
                </label>
                <label class="checkout-payment-method" style="display:flex;align-items:center;gap:var(--md-sys-spacing-md);padding:var(--md-sys-spacing-md);border:1.5px solid var(--md-sys-color-outline-variant);border-radius:var(--md-sys-shape-corner-large);cursor:pointer;">
                  <input type="radio" name="payment_method" value="cod" style="accent-color:var(--md-sys-color-primary);width:20px;height:20px;flex-shrink:0;">
                  <span class="material-symbols-rounded" style="color:var(--md-sys-color-primary)" aria-hidden="true">payments</span>
                  <span style="font-weight:600;color:var(--md-sys-color-on-surface);">الدفع عند الاستلام</span>
                </label>
              {% endfor %}
            </div>
          </section>

        </div>

        {# Order Summary Sidebar #}
        <div class="cart-summary">
          <h2 class="cart-summary__title">ملخص الطلب</h2>

          {# Cart items preview #}
          <div style="margin-bottom:var(--md-sys-spacing-md);">
            {% for item in cart.items %}
              <div style="display:flex;align-items:center;gap:var(--md-sys-spacing-sm);padding:var(--md-sys-spacing-sm) 0;{% if not loop.last %}border-bottom:1px solid var(--md-sys-color-outline-variant);{% endif %}">
                <img src="{{ item.product.images[0].url ?? '/assets/images/placeholder.png' }}" alt="{{ item.product.name }}" style="width:48px;height:48px;border-radius:var(--md-sys-shape-corner-small);object-fit:cover;" loading="lazy">
                <div style="flex:1;min-width:0;">
                  <div style="font-size:var(--md-sys-typescale-body-small-size);font-weight:600;color:var(--md-sys-color-on-surface);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ item.product.name }}</div>
                  <div style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">الكمية: {{ item.quantity }}</div>
                </div>
                <div style="font-size:var(--md-sys-typescale-body-small-size);font-weight:600;color:var(--md-sys-color-on-surface);flex-shrink:0;">
                  {{ (item.product.price.amount * item.quantity) | number_format(2) }} {{ item.product.price.currency | default('ر.س') }}
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary__row">
            <span class="cart-summary__label">المجموع الفرعي</span>
            <span class="cart-summary__value">{{ cart.subtotal.formatted }}</span>
          </div>

          {% if cart.discount %}
            <div class="cart-summary__row">
              <span class="cart-summary__label" style="color:var(--md-sys-color-error);">الخصم</span>
              <span class="cart-summary__value" style="color:var(--md-sys-color-error);">- {{ cart.discount.formatted }}</span>
            </div>
          {% endif %}

          <div class="cart-summary__row">
            <span class="cart-summary__label">الشحن</span>
            <span class="cart-summary__value">
              {% if cart.shipping.amount %}
                {{ cart.shipping.formatted }}
              {% else %}
                <span style="color:var(--md-sys-color-tertiary);font-weight:600;">مجاني</span>
              {% endif %}
            </span>
          </div>

          {% if cart.tax %}
            <div class="cart-summary__row">
              <span class="cart-summary__label">ضريبة القيمة المضافة (15%)</span>
              <span class="cart-summary__value">{{ cart.tax.formatted }}</span>
            </div>
          {% endif %}

          <div class="cart-summary__total">
            <span class="cart-summary__total-label">الإجمالي</span>
            <span class="cart-summary__total-value">{{ cart.total.formatted }}</span>
          </div>

          <button type="submit" class="md-btn md-btn--filled md-btn--full md-btn--lg" style="margin-top:var(--md-sys-spacing-lg);">
            <span class="material-symbols-rounded" aria-hidden="true">lock</span>
            تأكيد الطلب والدفع
          </button>

          <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:var(--md-sys-spacing-md);font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">
            <span class="material-symbols-rounded" style="font-size:14px" aria-hidden="true">lock</span>
            بياناتك محمية بتشفير 256-bit SSL
          </div>
        </div>

      </div>
    </form>

  </div>
{% endblock %}
