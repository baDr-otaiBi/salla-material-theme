{% extends 'layout/base.twig' %}

{% block title %}المفضلة - {{ store.name }}{% endblock %}
{% block body_class %}page-wishlist{% endblock %}

{% block content %}
  <div class="container" style="padding-top:var(--md-sys-spacing-lg);">

    {# Breadcrumb #}
    <nav class="md-breadcrumb" aria-label="مسار التنقل">
      <div class="md-breadcrumb__item">
        <a href="{{ store.url }}" class="md-breadcrumb__link">الرئيسية</a>
        <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
      </div>
      <div class="md-breadcrumb__item">
        <span class="md-breadcrumb__current" aria-current="page">المفضلة</span>
      </div>
    </nav>

    {# Page Header #}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--md-sys-spacing-xl);flex-wrap:wrap;gap:var(--md-sys-spacing-md);">
      <h1 class="md-headline-large" style="color:var(--md-sys-color-on-surface);">
        <span class="material-symbols-rounded" style="color:var(--md-sys-color-error);vertical-align:middle;margin-inline-end:8px;" aria-hidden="true">favorite</span>
        المفضلة
        {% if wishlist.items %}
          <span style="font-size:1rem;font-weight:400;color:var(--md-sys-color-on-surface-variant);">({{ wishlist.items | length }} منتج)</span>
        {% endif %}
      </h1>
    </div>

    {% if wishlist.items %}
      <div class="products-grid" role="list">
        {% for item in wishlist.items %}
          <article class="product-card product-card--{{ settings.card_style ?? 'elevated' }}" role="listitem" data-animate data-delay="{{ loop.index * 60 }}">

            {# Image #}
            <div class="product-card__image-wrap">
              <a href="{{ item.product.url }}" tabindex="-1" aria-hidden="true">
                <img
                  class="product-card__image"
                  src="{{ item.product.images[0].url ?? '/assets/images/placeholder.png' }}"
                  alt="{{ item.product.name }}"
                  loading="lazy"
                  decoding="async"
                >
              </a>

              {# Badges #}
              <div class="product-card__badge">
                {% if item.product.sale_price and item.product.sale_price.amount < item.product.regular_price.amount %}
                  {% set discount_pct = ((item.product.regular_price.amount - item.product.sale_price.amount) / item.product.regular_price.amount * 100) | round %}
                  <span class="badge badge--sale">خصم {{ discount_pct }}%</span>
                {% endif %}
                {% if item.product.is_out_of_stock %}
                  <span class="badge badge--out">نفذت</span>
                {% endif %}
              </div>

              {# Remove from wishlist #}
              <button
                class="product-card__wishlist"
                data-wishlist-btn
                data-product-id="{{ item.product.id }}"
                aria-label="إزالة {{ item.product.name }} من المفضلة"
                aria-pressed="true"
                style="color:var(--md-sys-color-error);"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </button>

              {# Quick Add #}
              {% if not item.product.is_out_of_stock %}
                <div class="product-card__quick-add">
                  <button data-add-to-cart data-product-id="{{ item.product.id }}" aria-label="إضافة {{ item.product.name }} إلى السلة">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M11 9h2V6h3V4h-3V1h-2v3H8v2h3v3zm-4 9c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-8.9-5h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0019.86 4H5.21l-.94-2H1v2h2l3.6 7.59L5.25 14c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63z"/>
                    </svg>
                    أضف إلى السلة
                  </button>
                </div>
              {% endif %}
            </div>

            {# Info #}
            <div class="product-card__info">
              {% if item.product.brand %}
                <div class="product-card__brand">{{ item.product.brand.name }}</div>
              {% endif %}
              <h3 class="product-card__name">
                <a href="{{ item.product.url }}" style="text-decoration:none;color:inherit;">{{ item.product.name }}</a>
              </h3>
              <div class="product-card__price">
                <span class="product-card__price-current">{{ item.product.price.formatted }}</span>
                {% if item.product.regular_price and item.product.regular_price.amount > item.product.price.amount %}
                  <span class="product-card__price-original">{{ item.product.regular_price.formatted }}</span>
                {% endif %}
              </div>
            </div>

          </article>
        {% endfor %}
      </div>

    {% else %}
      {# Empty Wishlist #}
      <div class="empty-state" style="padding:var(--md-sys-spacing-3xl) 0;">
        <div class="empty-state__icon">
          <span class="material-symbols-rounded" style="font-size:80px;color:var(--md-sys-color-error);opacity:0.4;" aria-hidden="true">favorite</span>
        </div>
        <h2 class="empty-state__title">قائمة المفضلة فارغة</h2>
        <p class="empty-state__desc">لم تضف أي منتجات إلى المفضلة بعد. تصفح المنتجات وأضف ما يعجبك!</p>
        <a href="{{ store.url }}/products" class="md-btn md-btn--filled md-btn--lg">
          <span class="material-symbols-rounded" aria-hidden="true">shopping_bag</span>
          تصفح المنتجات
        </a>
      </div>
    {% endif %}

  </div>
{% endblock %}
