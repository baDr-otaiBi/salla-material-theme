{% extends 'layout/base.twig' %}

{% block title %}{{ product.name }} - {{ store.name }}{% endblock %}
{% block description %}{{ product.description | striptags | truncate(160) }}{% endblock %}
{% block og_type %}product{% endblock %}
{% block og_title %}{{ product.name }}{% endblock %}
{% block og_description %}{{ product.description | striptags | truncate(200) }}{% endblock %}
{% block og_image %}{{ product.images[0].url ?? store.logo }}{% endblock %}

{% block head_extra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ product.name | e('js') }}",
  "description": "{{ product.description | striptags | e('js') | truncate(500) }}",
  "image": "{{ product.images[0].url ?? '' }}",
  "brand": { "@type": "Brand", "name": "{{ product.brand.name ?? store.name | e('js') }}" },
  "offers": {
    "@type": "Offer",
    "price": "{{ product.price.amount }}",
    "priceCurrency": "{{ product.price.currency | default('SAR') }}",
    "availability": "{% if product.is_out_of_stock %}OutOfStock{% else %}InStock{% endif %}",
    "url": "{{ product.url }}"
  },
  "aggregateRating": {% if product.rating %}{
    "@type": "AggregateRating",
    "ratingValue": "{{ product.rating.stars }}",
    "reviewCount": "{{ product.rating.count }}"
  }{% else %}null{% endif %}
}
</script>
{% endblock %}

{% block body_class %}page-product{% endblock %}

{% block content %}
  <div class="container">

    {# Breadcrumb #}
    <nav class="md-breadcrumb" aria-label="مسار التنقل">
      <div class="md-breadcrumb__item">
        <a href="{{ store.url }}" class="md-breadcrumb__link">الرئيسية</a>
        <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
      </div>
      {% if product.category %}
        <div class="md-breadcrumb__item">
          <a href="{{ product.category.url }}" class="md-breadcrumb__link">{{ product.category.name }}</a>
          <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
        </div>
      {% endif %}
      <div class="md-breadcrumb__item">
        <span class="md-breadcrumb__current" aria-current="page">{{ product.name | truncate(40) }}</span>
      </div>
    </nav>

    {# Product Detail #}
    <div class="product-detail">

      {# Gallery #}
      <div class="product-gallery" role="region" aria-label="صور المنتج">
        <div class="product-gallery__main" id="product-main-image">
          <img
            src="{{ product.images[0].url ?? '/assets/images/placeholder.png' }}"
            alt="{{ product.name }}"
            id="main-product-img"
            loading="eager"
            fetchpriority="high"
          >
          {% if product.is_out_of_stock %}
            <div style="position:absolute;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;border-radius:var(--md-sys-shape-corner-extra-large);">
              <span class="badge badge--out" style="font-size:1rem;padding:12px 24px;">نفذت الكمية</span>
            </div>
          {% endif %}
        </div>

        {% if product.images | length > 1 %}
          <div class="product-gallery__thumbs" role="list" aria-label="صور مصغرة">
            {% for image in product.images %}
              <button
                class="product-gallery__thumb {% if loop.first %}active{% endif %}"
                data-src="{{ image.url }}"
                aria-label="عرض صورة {{ loop.index }}"
                role="listitem"
              >
                <img src="{{ image.url }}" alt="{{ product.name }} - صورة {{ loop.index }}" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# Product Info #}
      <div class="product-info">

        {# Brand #}
        {% if product.brand %}
          <a href="{{ product.brand.url }}" class="product-info__brand">
            <span class="material-symbols-rounded" style="font-size:16px" aria-hidden="true">verified</span>
            {{ product.brand.name }}
          </a>
        {% endif %}

        {# Title #}
        <h1 class="product-info__title">{{ product.name }}</h1>

        {# Rating #}
        {% if product.rating and settings.show_rating %}
          <div class="product-info__rating">
            <div class="md-rating" aria-label="تقييم {{ product.rating.stars }} من 5">
              {% for i in 1..5 %}
                <svg class="md-rating__star {% if i > product.rating.stars %}md-rating__star--empty{% endif %}"
                  viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              {% endfor %}
            </div>
            <span class="product-info__rating-value">{{ product.rating.stars }}</span>
            <a href="#reviews" class="product-info__rating-link">
              ({{ product.rating.count }} تقييم)
            </a>
          </div>
        {% endif %}

        {# SKU #}
        {% if product.sku %}
          <div style="font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);">
            رقم المنتج: <span style="font-weight:600;">{{ product.sku }}</span>
          </div>
        {% endif %}

        {# Price #}
        <div class="product-info__price">
          <div class="price-tag">
            <span class="price-tag__current">{{ product.price.formatted }}</span>
            {% if product.sale_price and product.sale_price.amount < product.price.amount %}
              <span class="price-tag__original">{{ product.regular_price.formatted }}</span>
              {% set discount = ((product.regular_price.amount - product.sale_price.amount) / product.regular_price.amount * 100) | round %}
              <span class="price-tag__discount">خصم {{ discount }}%</span>
            {% endif %}
          </div>
          {% if product.has_tax %}
            <div style="font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);margin-top:6px;">
              السعر شامل ضريبة القيمة المضافة 15%
            </div>
          {% endif %}
        </div>

        {# Product Options #}
        {% if product.options %}
          <div class="product-options">
            {% for option in product.options %}
              <div class="product-options__group" style="margin-bottom:var(--md-sys-spacing-md);">
                <div class="product-options__label">
                  {{ option.name }}
                  <span id="selected-{{ option.id }}">
                    {% if option.values[0] %}{{ option.values[0].name }}{% endif %}
                  </span>
                </div>

                {% if option.type == 'color' %}
                  <div class="color-swatches" role="group" aria-label="{{ option.name }}">
                    {% for value in option.values %}
                      <button
                        class="color-swatch {% if loop.first %}selected{% endif %}"
                        style="background-color: {{ value.color ?? '#ccc' }};"
                        title="{{ value.name }}"
                        data-name="{{ value.name }}"
                        data-image="{{ value.image ?? '' }}"
                        aria-label="{{ value.name }}"
                        {% if loop.first %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
                      ></button>
                    {% endfor %}
                  </div>

                {% else %}
                  <div class="size-options" role="group" aria-label="{{ option.name }}">
                    {% for value in option.values %}
                      <button
                        class="size-option {% if loop.first %}selected{% endif %} {% if not value.is_available %}disabled{% endif %}"
                        {% if not value.is_available %}disabled aria-disabled="true"{% endif %}
                        title="{{ value.name }}"
                      >
                        {{ value.name }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}

              </div>
            {% endfor %}
          </div>
        {% endif %}

        {# Quantity #}
        {% if not product.is_out_of_stock %}
          <div>
            <div class="product-options__label" style="margin-bottom:12px;">الكمية</div>
            <div class="quantity-selector" data-min="1" data-max="{{ product.quantity ?? 99 }}"
              data-unit-price="{{ product.price.amount }}">
              <button class="quantity-selector__btn" data-qty-minus aria-label="تقليل الكمية">−</button>
              <span class="quantity-selector__value" aria-live="polite">1</span>
              <button class="quantity-selector__btn" data-qty-plus aria-label="زيادة الكمية">+</button>
              <input type="hidden" name="quantity" value="1">
            </div>
          </div>
        {% endif %}

        {# Actions #}
        <div class="product-info__actions">
          {% if not product.is_out_of_stock %}
            <button
              class="md-btn md-btn--filled md-btn--xl"
              data-add-to-cart-main
              style="flex:1;"
            >
              <span class="material-symbols-rounded" aria-hidden="true">shopping_cart</span>
              أضف إلى السلة
            </button>
            <button
              class="md-btn md-btn--tonal md-btn--xl"
              data-buy-now
            >
              <span class="material-symbols-rounded" aria-hidden="true">bolt</span>
              اشتر الآن
            </button>
          {% else %}
            <button class="md-btn md-btn--outlined md-btn--xl md-btn--full" disabled>
              نفذت الكمية
            </button>
          {% endif %}
          <button
            class="md-icon-btn md-icon-btn--outlined"
            data-wishlist-btn
            data-product-id="{{ product.id }}"
            aria-label="أضف إلى المفضلة"
            style="width:56px;height:56px;"
          >
            <span class="material-symbols-rounded" aria-hidden="true">favorite</span>
          </button>
        </div>

        {# Meta info #}
        <div style="display:flex;flex-direction:column;gap:8px;padding:var(--md-sys-spacing-md);background:var(--md-sys-color-surface-container-lowest);border-radius:var(--md-sys-shape-corner-medium);border:1px solid var(--md-sys-color-outline-variant);">
          {% if product.category %}
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);">
              <span class="material-symbols-rounded" style="font-size:18px" aria-hidden="true">category</span>
              التصنيف: <a href="{{ product.category.url }}" style="color:var(--md-sys-color-primary);font-weight:600;">{{ product.category.name }}</a>
            </div>
          {% endif %}
          {% if product.is_available and not product.is_out_of_stock %}
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-tertiary);">
              <span class="material-symbols-rounded" style="font-size:18px" aria-hidden="true">check_circle</span>
              متوفر في المخزون
            </div>
          {% endif %}
          <div style="display:flex;align-items:center;gap:8px;font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);">
            <span class="material-symbols-rounded" style="font-size:18px" aria-hidden="true">local_shipping</span>
            شحن سريع خلال 2-5 أيام عمل
          </div>
        </div>

      </div>
    </div>

    {# =============================================
       PRODUCT TABS: Description, Specifications, Reviews
       ============================================= #}
    <div class="product-tabs" id="product-tabs">
      <div class="md-tabs" data-tabs role="tablist">
        <button class="md-tab active" data-tab="description" role="tab" aria-selected="true" aria-controls="tab-description">
          وصف المنتج
        </button>
        {% if product.specifications %}
          <button class="md-tab" data-tab="specs" role="tab" aria-selected="false" aria-controls="tab-specs">
            المواصفات
          </button>
        {% endif %}
        {% if product.rating %}
          <button class="md-tab" data-tab="reviews" role="tab" aria-selected="false" aria-controls="tab-reviews" id="reviews">
            التقييمات
            <span class="md-badge" style="position:static;min-width:24px;height:20px;font-size:11px;background:var(--md-sys-color-secondary-container);color:var(--md-sys-color-on-secondary-container);">{{ product.rating.count }}</span>
          </button>
        {% endif %}
      </div>

      {# Description Tab #}
      <div id="tab-description" data-tab-panel="description" role="tabpanel" style="padding:var(--md-sys-spacing-xl) 0;">
        <div class="md-body-large" style="line-height:1.9;color:var(--md-sys-color-on-surface);">
          {{ product.description | raw }}
        </div>
      </div>

      {# Specifications Tab #}
      {% if product.specifications %}
        <div id="tab-specs" data-tab-panel="specs" role="tabpanel" hidden style="padding:var(--md-sys-spacing-xl) 0;">
          <div style="display:grid;gap:1px;border-radius:var(--md-sys-shape-corner-large);overflow:hidden;border:1px solid var(--md-sys-color-outline-variant);">
            {% for spec in product.specifications %}
              <div style="display:grid;grid-template-columns:1fr 2fr;background:var(--md-sys-color-surface-container-low);">
                <div style="padding:14px 20px;font-weight:600;font-size:var(--md-sys-typescale-body-medium-size);color:var(--md-sys-color-on-surface-variant);border-inline-end:1px solid var(--md-sys-color-outline-variant);">
                  {{ spec.name }}
                </div>
                <div style="padding:14px 20px;font-size:var(--md-sys-typescale-body-medium-size);color:var(--md-sys-color-on-surface);">
                  {{ spec.value }}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {# Reviews Tab #}
      {% if product.rating %}
        <div id="tab-reviews" data-tab-panel="reviews" role="tabpanel" hidden style="padding:var(--md-sys-spacing-xl) 0;">
          {% include 'views/components/reviews.twig' %}
        </div>
      {% endif %}

    </div>

    {# =============================================
       RELATED PRODUCTS
       ============================================= #}
    {% if related_products %}
      <section class="section" aria-labelledby="related-title">
        <div class="section-header">
          <h2 id="related-title" class="section-header__title">منتجات قد تعجبك</h2>
        </div>
        <div class="products-grid">
          {% for product in related_products | slice(0, 4) %}
            {% include 'views/components/product-card.twig' with { product: product, animate: true, index: loop.index } %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

  </div>

  {# Sticky Add to Cart Bar (mobile) #}
  <div class="sticky-add-to-cart" style="
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    z-index:100;
    background:var(--md-sys-color-surface-container);
    border-top:1px solid var(--md-sys-color-outline-variant);
    padding:12px 16px;
    padding-bottom:calc(12px + env(safe-area-inset-bottom));
    display:none;
    align-items:center;
    gap:12px;
    box-shadow:var(--md-sys-elevation-level3);
  " id="sticky-cart-bar">
    <div>
      <div style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">السعر</div>
      <div style="font-weight:700;color:var(--md-sys-color-primary);">{{ product.price.formatted }}</div>
    </div>
    {% if not product.is_out_of_stock %}
      <button class="md-btn md-btn--filled md-btn--full" data-add-to-cart>
        <span class="material-symbols-rounded" aria-hidden="true">shopping_cart</span>
        أضف إلى السلة
      </button>
    {% endif %}
  </div>
{% endblock %}

{% block scripts_extra %}
<script src="{{ 'assets/js/product.js' | asset_url }}" defer></script>
{% endblock %}
