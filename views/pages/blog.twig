{% extends 'layout/base.twig' %}

{% block title %}المدونة - {{ store.name }}{% endblock %}
{% block body_class %}page-blog{% endblock %}

{% block content %}
  <div class="container" style="padding-top:var(--md-sys-spacing-lg);">

    {# Breadcrumb #}
    <nav class="md-breadcrumb" aria-label="مسار التنقل">
      <div class="md-breadcrumb__item">
        <a href="{{ store.url }}" class="md-breadcrumb__link">الرئيسية</a>
        <span class="md-breadcrumb__separator" aria-hidden="true">‹</span>
      </div>
      <div class="md-breadcrumb__item">
        <span class="md-breadcrumb__current" aria-current="page">المدونة</span>
      </div>
    </nav>

    {# Page Header #}
    <div style="text-align:center;padding:var(--md-sys-spacing-2xl) 0 var(--md-sys-spacing-xl);">
      <h1 class="md-headline-large" style="color:var(--md-sys-color-on-surface);margin-bottom:var(--md-sys-spacing-sm);">المدونة</h1>
      <p style="color:var(--md-sys-color-on-surface-variant);font-size:var(--md-sys-typescale-body-large-size);max-width:500px;margin:0 auto;">
        مقالات ونصائح مفيدة من فريقنا
      </p>
    </div>

    {# Blog Tags/Categories #}
    {% if blog_categories %}
      <div class="md-chips" style="justify-content:center;margin-bottom:var(--md-sys-spacing-xl);" role="list" aria-label="تصنيفات المدونة">
        <a href="{{ store.url }}/blog" class="md-chip md-chip--filter {% if not current_category %}selected{% endif %}" role="listitem">الكل</a>
        {% for cat in blog_categories %}
          <a href="{{ cat.url }}" class="md-chip md-chip--filter {% if current_category.id == cat.id %}selected{% endif %}" role="listitem">{{ cat.name }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% if articles.data %}
      {# Featured Article (first) #}
      {% set featured = articles.data | first %}
      <a href="{{ featured.url }}" style="text-decoration:none;display:block;margin-bottom:var(--md-sys-spacing-2xl);">
        <article class="blog-featured" style="display:grid;grid-template-columns:1fr 1fr;gap:var(--md-sys-spacing-xl);background:var(--md-sys-color-surface-container-low);border-radius:var(--md-sys-shape-corner-extra-large);overflow:hidden;border:1px solid var(--md-sys-color-outline-variant);transition:box-shadow var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-standard);">
          <div style="aspect-ratio:16/10;overflow:hidden;">
            {% if featured.image %}
              <img src="{{ featured.image }}" alt="{{ featured.title }}" loading="eager" style="width:100%;height:100%;object-fit:cover;transition:transform var(--md-sys-motion-duration-medium4) var(--md-sys-motion-easing-emphasized);">
            {% else %}
              <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--md-sys-color-primary-container),var(--md-sys-color-tertiary-container));display:flex;align-items:center;justify-content:center;">
                <span class="material-symbols-rounded" style="font-size:64px;color:var(--md-sys-color-on-primary-container);opacity:0.4;" aria-hidden="true">article</span>
              </div>
            {% endif %}
          </div>
          <div style="padding:var(--md-sys-spacing-xl);display:flex;flex-direction:column;justify-content:center;">
            {% if featured.category %}
              <span style="font-size:var(--md-sys-typescale-label-large-size);font-weight:600;color:var(--md-sys-color-primary);margin-bottom:var(--md-sys-spacing-sm);">{{ featured.category.name }}</span>
            {% endif %}
            <h2 style="font-size:var(--md-sys-typescale-headline-small-size);font-weight:700;color:var(--md-sys-color-on-surface);margin-bottom:var(--md-sys-spacing-md);line-height:1.3;">
              {{ featured.title }}
            </h2>
            <p style="font-size:var(--md-sys-typescale-body-medium-size);color:var(--md-sys-color-on-surface-variant);line-height:1.7;margin-bottom:var(--md-sys-spacing-md);">
              {{ featured.excerpt ?? featured.content | striptags | truncate(200) }}
            </p>
            <div style="display:flex;align-items:center;gap:var(--md-sys-spacing-md);font-size:var(--md-sys-typescale-label-medium-size);color:var(--md-sys-color-on-surface-variant);">
              {% if featured.author %}
                <span>{{ featured.author.name }}</span>
                <span>·</span>
              {% endif %}
              <span>{{ featured.created_at | date('d M Y') }}</span>
              {% if featured.reading_time %}
                <span>·</span>
                <span>{{ featured.reading_time }} دقيقة قراءة</span>
              {% endif %}
            </div>
          </div>
        </article>
      </a>

      {# Articles Grid #}
      {% if articles.data | length > 1 %}
        <div class="blog-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:var(--md-sys-spacing-lg);padding-bottom:var(--md-sys-spacing-2xl);">
          {% for article in articles.data | slice(1) %}
            <a href="{{ article.url }}" style="text-decoration:none;" data-animate data-delay="{{ loop.index * 80 }}">
              <article style="background:var(--md-sys-color-surface-container-lowest);border-radius:var(--md-sys-shape-corner-extra-large);overflow:hidden;border:1px solid var(--md-sys-color-outline-variant);transition:box-shadow var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-standard),transform var(--md-sys-motion-duration-medium1) var(--md-sys-motion-easing-emphasized);height:100%;display:flex;flex-direction:column;">
                <div style="aspect-ratio:16/9;overflow:hidden;">
                  {% if article.image %}
                    <img src="{{ article.image }}" alt="{{ article.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform var(--md-sys-motion-duration-medium4) var(--md-sys-motion-easing-emphasized);">
                  {% else %}
                    <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--md-sys-color-secondary-container),var(--md-sys-color-primary-container));display:flex;align-items:center;justify-content:center;">
                      <span class="material-symbols-rounded" style="font-size:48px;color:var(--md-sys-color-on-secondary-container);opacity:0.4;" aria-hidden="true">article</span>
                    </div>
                  {% endif %}
                </div>
                <div style="padding:var(--md-sys-spacing-lg);flex:1;display:flex;flex-direction:column;">
                  {% if article.category %}
                    <span style="font-size:var(--md-sys-typescale-label-medium-size);font-weight:600;color:var(--md-sys-color-primary);margin-bottom:8px;">{{ article.category.name }}</span>
                  {% endif %}
                  <h3 style="font-size:var(--md-sys-typescale-title-medium-size);font-weight:700;color:var(--md-sys-color-on-surface);margin-bottom:8px;line-height:1.4;">
                    {{ article.title }}
                  </h3>
                  <p style="font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-on-surface-variant);line-height:1.6;flex:1;">
                    {{ article.excerpt ?? article.content | striptags | truncate(120) }}
                  </p>
                  <div style="display:flex;align-items:center;gap:8px;margin-top:var(--md-sys-spacing-md);font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">
                    <span>{{ article.created_at | date('d M Y') }}</span>
                    {% if article.reading_time %}
                      <span>·</span>
                      <span>{{ article.reading_time }} د</span>
                    {% endif %}
                  </div>
                </div>
              </article>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {# Pagination #}
      {% if articles.last_page > 1 %}
        <nav class="md-pagination" aria-label="التصفح بين الصفحات" style="display:flex;justify-content:center;gap:8px;margin-top:var(--md-sys-spacing-xl);margin-bottom:var(--md-sys-spacing-2xl);flex-wrap:wrap;">
          {% if articles.current_page > 1 %}
            <a href="{{ store.url }}/blog?page={{ articles.current_page - 1 }}" class="md-btn md-btn--outlined" aria-label="الصفحة السابقة">
              <span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
              السابق
            </a>
          {% endif %}
          {% for page in 1..articles.last_page %}
            {% if page == articles.current_page %}
              <span class="md-btn md-btn--filled" aria-current="page" style="min-width:40px;">{{ page }}</span>
            {% elseif page == 1 or page == articles.last_page or (page >= articles.current_page - 2 and page <= articles.current_page + 2) %}
              <a href="{{ store.url }}/blog?page={{ page }}" class="md-btn md-btn--outlined" style="min-width:40px;">{{ page }}</a>
            {% elseif page == articles.current_page - 3 or page == articles.current_page + 3 %}
              <span style="align-self:center;color:var(--md-sys-color-on-surface-variant);">...</span>
            {% endif %}
          {% endfor %}
          {% if articles.current_page < articles.last_page %}
            <a href="{{ store.url }}/blog?page={{ articles.current_page + 1 }}" class="md-btn md-btn--outlined" aria-label="الصفحة التالية">
              التالي
              <span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
            </a>
          {% endif %}
        </nav>
      {% endif %}

    {% else %}
      {# No Articles #}
      <div class="empty-state" style="padding:var(--md-sys-spacing-3xl) 0;">
        <div class="empty-state__icon">
          <span class="material-symbols-rounded" style="font-size:80px;color:var(--md-sys-color-primary);opacity:0.4;" aria-hidden="true">article</span>
        </div>
        <h2 class="empty-state__title">لا توجد مقالات بعد</h2>
        <p class="empty-state__desc">ترقبوا مقالاتنا القادمة</p>
        <a href="{{ store.url }}" class="md-btn md-btn--filled">
          العودة للرئيسية
        </a>
      </div>
    {% endif %}

  </div>
{% endblock %}
