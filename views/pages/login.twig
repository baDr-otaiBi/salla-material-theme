{% extends 'layout/base.twig' %}
{% block title %}تسجيل الدخول - {{ store.name }}{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block content %}
<div class="auth-page">
  <div class="auth-card">

    <div class="auth-card__logo">
      {% if settings.store_logo %}
        <img src="{{ settings.store_logo }}" alt="{{ store.name }}" height="48" style="margin:0 auto;">
      {% else %}
        <span style="font-size:2rem;font-weight:800;color:var(--md-sys-color-primary);">{{ store.name }}</span>
      {% endif %}
    </div>

    <h1 class="auth-card__title">تسجيل الدخول</h1>
    <p class="auth-card__subtitle">أهلاً بعودتك! سجّل دخولك للمتابعة</p>

    {% if error %}
      <div style="background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container);padding:12px 16px;border-radius:var(--md-sys-shape-corner-medium);margin-bottom:16px;font-size:var(--md-sys-typescale-body-medium-size);">
        <span class="material-symbols-rounded" style="font-size:18px;vertical-align:middle;margin-inline-end:6px" aria-hidden="true">error</span>
        {{ error }}
      </div>
    {% endif %}

    <form class="auth-form" method="POST" action="{{ store.url }}/login" novalidate>
      {{ csrf_field() }}

      <div class="md-field">
        <label class="md-field__label" for="email">البريد الإلكتروني</label>
        <input
          class="md-field__input"
          type="email"
          id="email"
          name="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          value="{{ old.email }}"
        >
      </div>

      <div class="md-field">
        <label class="md-field__label" for="password">كلمة المرور</label>
        <input
          class="md-field__input"
          type="password"
          id="password"
          name="password"
          placeholder="••••••••"
          required
          autocomplete="current-password"
        >
        <a href="{{ store.url }}/forgot-password" style="font-size:var(--md-sys-typescale-label-medium-size);color:var(--md-sys-color-primary);align-self:flex-end;margin-top:4px;">نسيت كلمة المرور؟</a>
      </div>

      <button type="submit" class="md-btn md-btn--filled md-btn--full md-btn--lg">
        <span class="material-symbols-rounded" aria-hidden="true">login</span>
        تسجيل الدخول
      </button>

    </form>

    <div class="auth-divider">أو</div>

    <p style="text-align:center;font-size:var(--md-sys-typescale-body-medium-size);color:var(--md-sys-color-on-surface-variant);">
      ليس لديك حساب؟
      <a href="{{ store.url }}/register" style="font-weight:700;color:var(--md-sys-color-primary);">إنشاء حساب جديد</a>
    </p>

  </div>
</div>
{% endblock %}
