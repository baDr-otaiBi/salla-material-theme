{#
  Product Card Component - Material You
  Salla Material Theme

  Parameters:
  - product: Product object from Salla
  - card_style: 'elevated' | 'filled' | 'outlined' (default from settings)
  - animate: boolean (enable scroll animation)
  - index: integer (for stagger animation delay)
  - is_new: boolean (show NEW badge)
#}

{% set style = card_style ?? settings.card_style ?? 'elevated' %}
{% set show_quick_add   = settings.show_quick_add   ?? true %}
{% set show_rating      = settings.show_rating      ?? true %}
{% set show_wishlist    = settings.show_wishlist_btn ?? true %}
{% set img_ratio        = settings.image_aspect_ratio ?? 'square' %}

<article
  class="product-card product-card--{{ style }}"
  role="listitem"
  {% if animate %}
  data-animate
  data-delay="{{ (index ?? 1) * 60 }}"
  {% endif %}
>

  {# Image Wrapper #}
  <div class="product-card__image-wrap product-card__image-wrap--{{ img_ratio }}">

    {# Product Image #}
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      <img
        class="product-card__image"
        src="{{ product.images[0].url ?? '/assets/images/placeholder.png' }}"
        alt="{{ product.name }}"
        loading="lazy"
        decoding="async"
        {% if product.images[1] is defined %}
        data-hover="{{ product.images[1].url }}"
        {% endif %}
      >
    </a>

    {# Badges #}
    <div class="product-card__badge" aria-label="شارات المنتج">
      {% if product.sale_price and product.sale_price.amount < product.regular_price.amount %}
        {% set discount_pct = ((product.regular_price.amount - product.sale_price.amount) / product.regular_price.amount * 100) | round %}
        <span class="badge badge--sale">خصم {{ discount_pct }}%</span>
      {% endif %}
      {% if is_new or (product.created_at and product.created_at > "now - 14 days") %}
        <span class="badge badge--new">جديد</span>
      {% endif %}
      {% if product.is_out_of_stock %}
        <span class="badge badge--out">نفذت</span>
      {% endif %}
    </div>

    {# Wishlist Button #}
    {% if show_wishlist %}
      <button
        class="product-card__wishlist"
        data-wishlist-btn
        data-product-id="{{ product.id }}"
        aria-label="أضف {{ product.name }} إلى المفضلة"
        aria-pressed="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>
    {% endif %}

    {# Quick Add Button #}
    {% if show_quick_add and not product.is_out_of_stock %}
      <div class="product-card__quick-add">
        <button
          data-add-to-cart
          data-product-id="{{ product.id }}"
          aria-label="إضافة {{ product.name }} إلى السلة"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11 9h2V6h3V4h-3V1h-2v3H8v2h3v3zm-4 9c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-8.9-5h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0019.86 4H5.21l-.94-2H1v2h2l3.6 7.59L5.25 14c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63z"/>
          </svg>
          أضف إلى السلة
        </button>
      </div>
    {% endif %}

  </div>

  {# Product Info #}
  <div class="product-card__info">

    {# Brand #}
    {% if product.brand %}
      <div class="product-card__brand">{{ product.brand.name }}</div>
    {% endif %}

    {# Name #}
    <h3 class="product-card__name">
      <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
        {{ product.name }}
      </a>
    </h3>

    {# Rating #}
    {% if show_rating and product.rating %}
      <div class="product-card__rating" aria-label="تقييم {{ product.rating.stars }} من 5 ({{ product.rating.count }} تقييم)">
        <div class="product-card__stars" aria-hidden="true">
          {% for i in 1..5 %}
            <svg viewBox="0 0 24 24" fill="{{ i <= product.rating.stars ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="product-card__rating-count">({{ product.rating.count }})</span>
      </div>
    {% endif %}

    {# Price #}
    <div class="product-card__price">
      <span class="product-card__price-current">{{ product.price.formatted }}</span>
      {% if product.regular_price and product.regular_price.amount > product.price.amount %}
        <span class="product-card__price-original">{{ product.regular_price.formatted }}</span>
        {% set discount_pct = ((product.regular_price.amount - product.price.amount) / product.regular_price.amount * 100) | round %}
        <span class="product-card__price-discount">{{ discount_pct }}%</span>
      {% endif %}
    </div>

  </div>

</article>
